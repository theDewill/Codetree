# Copy to .env. The development launcher loads this file for the Go API.
CODETREE_ADDR=127.0.0.1:8090
CODETREE_ORIGIN=http://127.0.0.1:5173
CODETREE_DATA_DIR=.data

# Optional: enables real accounts. Configure Google/GitHub/Apple in Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Comma-separated verified Supabase user IDs with developer access.
CODETREE_ADMIN_IDS=

# Optional: initial OpenAI-compatible model. Additional models are added in admin.
CODETREE_MODEL_NAME=
CODETREE_MODEL_ID=
CODETREE_MODEL_BASE_URL=https://api.openai.com/v1
CODETREE_MODEL_API_KEY=

# Optional GitHub App user authorization for private repositories.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Callback: http://127.0.0.1:5173/api/v1/github/callback

# Production must set secure cookies and bind behind an HTTPS reverse proxy.
CODETREE_SECURE_COOKIES=false
